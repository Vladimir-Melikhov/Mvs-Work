{
    admin off
}

mvs-work.ru, www.mvs-work.ru {
    # WebSocket для чата
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }

    handle @websocket {
        reverse_proxy chat:8003
    }

    # Django Admin — у auth свой /admin, у market свой
    handle /auth-admin* {
        reverse_proxy auth:8001
    }

    handle /admin* {
        reverse_proxy market:8002
    }

    # Статика Django Admin
    handle /static* {
        reverse_proxy market:8002
    }

    handle /auth-static* {
        reverse_proxy auth:8001
    }

    # API маршруты
    handle /api/auth/* {
        reverse_proxy auth:8001
    }

    handle /api/market/* {
        reverse_proxy market:8002
    }

    handle /api/chat/* {
        reverse_proxy chat:8003
    }

    # Медиа файлы
    handle /media/avatars/* {
        reverse_proxy auth:8001
    }

    handle /media/service_images/* {
        reverse_proxy market:8002
    }

    handle /media/deal_deliveries/* {
        reverse_proxy market:8002
    }

    handle /media/message_attachments/* {
        reverse_proxy chat:8003
    }

    # Frontend (последним)
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}